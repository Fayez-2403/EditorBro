{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "color": "#0B1B2B", "name": "Ink" },
				{ "slug": "harbour", "color": "#132A40", "name": "Harbour" },
				{ "slug": "steel", "color": "#2C5A7A", "name": "Steel" },
				{ "slug": "signal", "color": "#F26A1F", "name": "Signal" },
				{ "slug": "signal-ink", "color": "#B9480F", "name": "Signal (text)" },
				{ "slug": "paper", "color": "#F5F2EC", "name": "Paper" },
				{ "slug": "sand", "color": "#EBE5D9", "name": "Sand" },
				{ "slug": "muted", "color": "#566476", "name": "Muted" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{ "slug": "display", "name": "Barlow Condensed", "fontFamily": "\"Barlow Condensed\", \"Arial Narrow\", sans-serif" },
				{ "slug": "body", "name": "Barlow", "fontFamily": "Barlow, system-ui, sans-serif" },
				{ "slug": "mono", "name": "IBM Plex Mono", "fontFamily": "\"IBM Plex Mono\", ui-monospace, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "14px", "name": "Small" },
				{ "slug": "medium", "size": "17px", "name": "Medium" },
				{ "slug": "large", "size": "22px", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(34px, 4vw, 54px)", "name": "Extra large" },
				{ "slug": "huge", "size": "clamp(46px, 6.2vw, 88px)", "name": "Huge" }
			]
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw"]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|paper",
			"text": "var:preset|color|ink"
		},
		"spacing": {
			"padding": { "left": "24px", "right": "24px" },
			"blockGap": "24px"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700",
					"lineHeight": "0.98",
					"textTransform": "uppercase"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"link": {
				"color": { "text": "var:preset|color|signal-ink" },
				":hover": { "color": { "text": "var:preset|color|ink" } }
			},
			"button": {
				"color": { "background": "var:preset|color|signal", "text": "var:preset|color|ink" },
				"border": { "radius": "2px" },
				"typography": { "fontWeight": "600", "letterSpacing": "0.06em", "textTransform": "uppercase", "fontSize": "15px" },
				":hover": { "color": { "background": "var:preset|color|ink", "text": "var:preset|color|white" } }
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": { "fontSize": "27px", "lineHeight": "1.02" },
				"elements": { "link": { "color": { "text": "var:preset|color|ink" } } }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontFamily": "var:preset|font-family|mono", "fontSize": "12px", "letterSpacing": "0.1em", "textTransform": "uppercase" }
			},
			"core/post-excerpt": {
				"color": { "text": "var:preset|color|muted" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
